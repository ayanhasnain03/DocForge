# Admin panel (required for /admin login)
ADMIN_SECRET_KEY=change-me-to-a-long-random-string

# Content backend: "fs" (local disk) or "github" (commit to repo)
# If GITHUB_TOKEN + GITHUB_REPO are set, github is used automatically.
CONTENT_BACKEND=fs

# GitHub storage (for production admin saves → auto-deploy)
GITHUB_TOKEN=
GITHUB_REPO=your-user/harc-docs
GITHUB_BRANCH=main
GITHUB_CONTENT_PREFIX=content/docs
